PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PORT=8787

# Optional but recommended before testing OAuth institutions.
# Must be HTTPS and added to Plaid Dashboard > Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=https://pay-pilot-backend-production.up.railway.app/plaid/oauth-redirect

# Hosted Link completion returns to the Android app through its custom scheme.
PLAID_COMPLETION_REDIRECT_URI=payaviator://plaid-complete

# Optional public webhook endpoint for Plaid Link webhooks.
PLAID_WEBHOOK_URL=

# REQUIRED Railway/Postgres storage for bank connections.
DATABASE_URL=
# Set to disable only for a local database that does not use SSL.
PGSSL=

# Firebase project ID must match app/google-services.json.
FIREBASE_PROJECT_ID=payaviator-app

# In Railway connect an actual PostgreSQL service and use a DATABASE_URL
# reference, rather than pasting a credential into GitHub.
