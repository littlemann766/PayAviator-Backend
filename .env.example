# ---------------------------------------------------------------------------
# PayAviator backend configuration. Copy to .env for local use; on Railway set
# these as service Variables. Never commit real values.
# ---------------------------------------------------------------------------

# --- Plaid -------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (anything else fails at startup)
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=PayAviator
# Comma-separated ISO country codes for Link
PLAID_COUNTRY_CODES=US
# Required in production. HTTPS; must be listed in Plaid Dashboard > Developers > API > Allowed redirect URIs.
PLAID_REDIRECT_URI=https://payaviator-backend-production.up.railway.app/plaid/oauth-redirect
# Required in production. Public HTTPS URL of POST /api/plaid/webhook (passed in every link token).
PLAID_WEBHOOK_URL=https://payaviator-backend-production.up.railway.app/api/plaid/webhook
# Hosted Link completion returns to the Android app through its custom scheme.
PLAID_COMPLETION_REDIRECT_URI=payaviator://plaid-complete
# Where /plaid/oauth-redirect sends the user back to the app.
PLAID_OAUTH_RETURN_URI=payaviator://plaid-oauth-return
# Days of transaction history requested at link time (1-730). Cannot be increased later for an existing Item.
PLAID_TRANSACTIONS_DAYS_REQUESTED=730
# Per-request timeout for Plaid API calls (ms)
PLAID_TIMEOUT_MS=30000

# --- Auth (exactly one mode; checked in this order) --------------------------
# 1) Firebase Auth: app sends Firebase ID token. Verified against Google's public keys.
# Must match app/google-services.json (payaviator-app).
FIREBASE_PROJECT_ID=payaviator-app
# 2) Any OIDC/JWKS provider (Auth0, Clerk, Supabase, Cognito...). Issuer + audience required in production.
AUTH_JWKS_URL=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Optional, comma-separated (default RS256,ES256)
AUTH_JWT_ALGORITHMS=
# 3) Your own HS256-signed JWTs (min 32 chars). AUTH_JWT_ISSUER/AUDIENCE are also enforced if set.
APP_JWT_SECRET=
# Local Sandbox ONLY: disables auth (user from X-Dev-User-Id header). Refused when PLAID_ENV=production.
AUTH_DISABLED=

# --- Storage -----------------------------------------------------------------
# REQUIRED in production (in-memory storage is refused). In Railway, use a reference
# to the PostgreSQL service's DATABASE_URL rather than pasting a credential into GitHub.
DATABASE_URL=
# 32 random bytes, as base64 or 64 hex chars. Required in production and whenever DATABASE_URL is set.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored access tokens unreadable (users must relink).
TOKEN_ENCRYPTION_KEY=
# Postgres TLS. Default: verify certificates in production.
# PGSSL=disable turns TLS off (only for Railway private networking *.railway.internal or local DBs).
PGSSL=
# PEM (or base64 PEM) CA certificate used to verify the database server.
DATABASE_SSL_CA=
# Escape hatch: false = encrypt but do not verify the server certificate (logs a loud warning in production).
DATABASE_SSL_REJECT_UNAUTHORIZED=

# --- HTTP --------------------------------------------------------------------
PORT=8787
# Comma-separated browser origins allowed by CORS (Android WebView default below).
CORS_ORIGINS=https://appassets.androidplatform.net
# Express trust proxy setting (1 = one proxy hop, correct for Railway)
TRUST_PROXY=1
# Requests per user per 15 minutes (general / Link token creation)
RATE_LIMIT_MAX=300
RATE_LIMIT_LINK_MAX=30

# --- Google Play billing (one bank free; 2+ banks need an active subscription) ---
# Missing => /api/billing/google-play/* return 503 billing_not_configured; the free 1-bank limit is still enforced.
# Service-account key JSON (raw JSON or base64 of it). The account must be invited in Play Console with
# "View financial data" + "Manage orders and subscriptions".
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Android applicationId, e.g. app.payaviator
ANDROID_PACKAGE_NAME=
# Optional comma-separated allowlist of subscription product ids, e.g. payaviator_premium
GOOGLE_PLAY_PRODUCT_IDS=
# Optional RTDN (Pub/Sub push). Audience configured on the push subscription, usually the endpoint URL.
GOOGLE_PLAY_RTDN_AUDIENCE=
# Optional: service account email the push subscription signs as (checked against the token's email claim).
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=

# --- Free-tier anti-abuse (one free bank per bank account / device across emails) ---
# Secret for HMAC fingerprints, >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Missing => free-tier NEW bank links return 503 free_tier_not_configured (server still starts; subscribers unaffected).
# Changing it makes existing fingerprints unmatchable.
FREE_TIER_FINGERPRINT_SECRET=
# Days to keep fingerprints after a bank/account is deleted (default 30).
FREE_TIER_COOLDOWN_DAYS=30

# Live Plaid balance (accountsBalanceGet, ~$0.10/call): manual Refresh only. UTC days/months.
LIVE_BALANCE_COOLDOWN_SEC=900         # per bank
LIVE_BALANCE_ITEM_DAILY_CAP=3         # per bank per day
LIVE_BALANCE_ITEM_MONTHLY_CAP=10      # per bank per month
LIVE_BALANCE_USER_DAILY_CAP=5         # Plus (paying) users per day
LIVE_BALANCE_FREE_USER_DAILY_CAP=0    # free + comp/tester/founder users (0 = cached/webhook balances only)
LIVE_BALANCE_DAILY_CAP=200            # all users per day (cost guard)
