{
  "name": "payaviator-backend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && for f in src/*.js scripts/*.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.js",
    "cleanup:legacy": "node scripts/cleanup-legacy-items.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^13.10.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "plaid": "^48.0.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
